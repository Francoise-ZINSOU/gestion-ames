# À placer dans : .github/workflows/ci.yml
# Rôle : valider tests + build à chaque push, AVANT que Netlify ne déploie.
# Indispensable car le développement se fait via l'éditeur web GitHub (pas de Node local).

name: CI

on:
  push:
    branches: [main]
  pull_request:

jobs:
  test-and-build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm

      - name: Installer les dépendances
        run: npm ci

      - name: Tests (Vitest)
        run: npm run test

      - name: Build (Vite)
        run: npm run build
        env:
          # Valeurs factices : le build Vite n'a besoin des vraies clés qu'au runtime
          VITE_SUPABASE_URL: https://ci-placeholder.supabase.co
          VITE_SUPABASE_ANON_KEY: ci-placeholder
